# ──────────────────────────────────────────────
# NEXUS -- Environment Variables
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────

# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Upload limits
MAX_RESUME_UPLOAD_BYTES=10485760

# Video & Audio Briefing synthesis (optional)
# - D-ID API (https://studio.d-id.com/ - provides free trial credits)
DID_API_KEY=
# - HeyGen API (optional paid avatar video)
HEYGEN_API_KEY=
# (If both are empty, NEXUS automatically uses Edge-TTS for free audio briefings)

# Scraping politeness
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=5.0

# Scheduled runs cron secret (optional security token for /api/system/cron-run)
CRON_SECRET=

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=1234567890-abcdefg1234567.apps.googleusercontent.com