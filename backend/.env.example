# ──────────────────────────────────────────────
# NEXUS -- Environment Variables
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────

# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Upload limits
MAX_RESUME_UPLOAD_BYTES=10485760

# HeyGen API (optional -- falls back to Edge-TTS if empty)
HEYGEN_API_KEY=

# Scraping politeness
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=5.0

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
