# ──────────────────────────────────────────────
# NEXUS Frontend -- Environment Variables
# Copy this file to .env.local and fill in values.
# ──────────────────────────────────────────────

# Backend FastAPI URL (Local: http://localhost:8000 | Production: https://nexus-backend.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth 2.0 Client ID (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abcdefg1234567.apps.googleusercontent.com
